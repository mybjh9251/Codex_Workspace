<Window x:Class="OfflinePackageDownloader.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Target Settings" Height="520" Width="620" MinHeight="460" MinWidth="560"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F6F7F9" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Target Settings" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="These values are saved and restored after restart." Foreground="#5F6773" Margin="0,4,0,14" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDE2EA" BorderThickness="1" CornerRadius="6" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Common" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                    <TextBlock Text="Output Folder" />
                    <TextBox x:Name="OutputTextBox" Margin="0,4,0,10" />
                    <CheckBox x:Name="OverwriteCheckBox" Content="Overwrite existing artifacts" Margin="0,0,0,18" />

                    <StackPanel x:Name="NuGetPanel">
                        <TextBlock Text="NuGet Target" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                        <TextBlock Text="Package Source" />
                        <ComboBox x:Name="NuGetSourceComboBox" IsEditable="True" Margin="0,4,0,10" />
                        <TextBlock Text="Target Framework" />
                        <ComboBox x:Name="NuGetTargetFrameworkComboBox" IsEditable="True" Margin="0,4,0,10" />
                        <TextBlock Text="Max Parallelism" />
                        <ComboBox x:Name="NuGetMaxParallelismComboBox" IsEditable="True" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="PythonPanel" Visibility="Collapsed">
                        <TextBlock Text="Python Target" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                        <TextBlock Text="Python Executable" />
                        <TextBox x:Name="PythonExecutableTextBox" Margin="0,4,0,10" />
                        <TextBlock Text="Index URL" />
                        <ComboBox x:Name="PythonIndexUrlComboBox" IsEditable="True" Margin="0,4,0,10" />
                        <TextBlock Text="Platform" />
                        <ComboBox x:Name="PythonPlatformComboBox" IsEditable="True" Margin="0,4,0,10" />
                        <TextBlock Text="Python Version" />
                        <ComboBox x:Name="PythonVersionComboBox" IsEditable="True" Margin="0,4,0,10" />
                        <TextBlock Text="ABI" />
                        <TextBox x:Name="PythonAbiTextBox" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="VSCodePanel" Visibility="Collapsed">
                        <TextBlock Text="VS Code Extension Target" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                        <TextBlock Text="VS Code Version" />
                        <ComboBox x:Name="VSCodeVersionComboBox" IsEditable="True" Margin="0,4,0,10" />
                        <TextBlock Text="Target Platform" />
                        <ComboBox x:Name="VSCodeTargetPlatformComboBox" IsEditable="True" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="UbuntuPanel" Visibility="Collapsed">
                        <TextBlock Text="Ubuntu Target" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                        <TextBlock Text="Ubuntu Version" />
                        <ComboBox x:Name="UbuntuVersionComboBox" IsEditable="True" Margin="0,4,0,10" />
                        <TextBlock Text="Architecture" />
                        <ComboBox x:Name="UbuntuArchitectureComboBox" IsEditable="True" Margin="0,4,0,10" />
                        <TextBlock Text="Components" />
                        <ComboBox x:Name="UbuntuComponentsComboBox" IsEditable="True" Margin="0,4,0,10" />
                        <TextBlock Text="Pockets" />
                        <ComboBox x:Name="UbuntuPocketsComboBox" IsEditable="True" Margin="0,4,0,10" />
                        <TextBlock Text="Base URL" />
                        <ComboBox x:Name="UbuntuBaseUrlComboBox" IsEditable="True" Margin="0,4,0,10" />
                        <TextBlock Text="Max Packages" />
                        <TextBox x:Name="UbuntuMaxPackagesTextBox" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Padding="12,7" Margin="0,0,8,0" />
            <Button Content="Apply" IsDefault="True" Click="ApplyButton_Click" MinWidth="100" Padding="12,7" Background="#0B63CE" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
