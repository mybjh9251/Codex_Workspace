<Window x:Class="OfflinePackageDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Offline Package Downloader" Height="780" Width="1280" MinHeight="720" MinWidth="1100">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE2EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0B63CE" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0B63CE" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7DCE5" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6773" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ProviderTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F6F7F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDE2EA" BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TabControl x:Name="ProviderList"
                            SelectionChanged="ProviderList_SelectionChanged"
                            Style="{StaticResource ProviderTabs}"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="0"
                            MinHeight="44">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Padding="20,10" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton"
                            Content="Settings"
                            Click="SettingsButton_Click"
                            Style="{StaticResource SoftButton}"
                            MinWidth="96"
                            Margin="0,0,10,0" />
                    <Button x:Name="DownloadButton"
                            Content="Download"
                            Click="DownloadButton_Click"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0" />
                    <Button x:Name="ResolveButton"
                            Content="Preview"
                            Click="ResolveButton_Click"
                            Style="{StaticResource SoftButton}"
                            MinWidth="86"
                            Margin="0,0,8,0" />
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Click="CancelButton_Click"
                            Style="{StaticResource SoftButton}"
                            MinWidth="82"
                            IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchTextBox"
                                 Height="36"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"
                                 KeyDown="SearchTextBox_KeyDown" />
                        <Button Grid.Column="2" Content="Filter" Click="SearchButton_Click" Style="{StaticResource SoftButton}" Padding="6" />
                        <TextBlock Grid.Column="4" Text="Sort by:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#3F4650" />
                        <ComboBox Grid.Column="5" x:Name="SortComboBox" Height="36" SelectedIndex="0">
                            <ComboBoxItem Content="Relevance" />
                            <ComboBoxItem Content="Downloads" />
                            <ComboBoxItem Content="Name" />
                        </ComboBox>
                    </Grid>

                    <ListBox x:Name="SearchResultsList"
                             Grid.Row="1"
                             ItemsSource="{Binding SearchResults}"
                             SelectionChanged="SearchResultsList_SelectionChanged"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14" BorderBrush="#E6E9EF" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="#0B77D5" CornerRadius="7" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding IconText}" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PackageId}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="  by " Foreground="#5F6773" />
                                                <TextBlock Text="{Binding Publisher}" Foreground="#2F3640" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="#4F5865" TextTrimming="CharacterEllipsis" Margin="0,5,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DownloadsText}" Style="{StaticResource MetaText}" />
                                                <TextBlock Text="  |  " Style="{StaticResource MetaText}" />
                                                <TextBlock Text="{Binding LatestVersionText}" Style="{StaticResource MetaText}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="Add"
                                                Click="AddSearchResult_Click"
                                                Tag="{Binding}"
                                                Style="{StaticResource SoftButton}"
                                                MinWidth="82"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.1*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="0.9*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Selected Package" FontSize="16" FontWeight="SemiBold" />
                        <Grid Grid.Row="1" Margin="0,18,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" Background="#0B77D5" CornerRadius="12" VerticalAlignment="Top">
                                <TextBlock x:Name="SelectedIconText" Text="N" Foreground="White" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SelectedNameText" Text="Select a package" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="  by " Foreground="#5F6773" VerticalAlignment="Bottom" />
                                    <TextBlock x:Name="SelectedPublisherText" Text="" Foreground="#2F3640" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <UniformGrid Columns="4" Margin="0,14,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Downloads" Style="{StaticResource MetaText}" />
                                        <TextBlock x:Name="SelectedDownloadsText" Text="-" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Latest" Style="{StaticResource MetaText}" />
                                        <TextBlock x:Name="SelectedVersionText" Text="-" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="License" Style="{StaticResource MetaText}" />
                                        <TextBlock x:Name="SelectedLicenseText" Text="-" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Provider" Style="{StaticResource MetaText}" />
                                        <TextBlock x:Name="SelectedProviderText" Text="-" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock x:Name="SelectedDescriptionText" TextWrapping="Wrap" Foreground="#374151" />
                                <TextBlock Text="Dependency preview" FontWeight="SemiBold" Margin="0,14,0,6" />
                                <TextBlock x:Name="SelectedDependenciesText" Text="Resolve Preview updates exact dependencies." Foreground="#4F5865" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Button Grid.Row="2"
                                x:Name="AddSelectedButton"
                                Content="Add to Queue"
                                Click="AddSelectedButton_Click"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear All" Click="ClearAddedButton_Click" Style="{StaticResource SoftButton}" MinWidth="82" />
                            <TextBlock Text="Added Packages" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid Grid.Row="1"
                                  x:Name="AddedPackagesGrid"
                                  ItemsSource="{Binding AddedPackages}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Package" Binding="{Binding PackageId}" Width="2*" />
                                <DataGridTextColumn Header="Requested" Binding="{Binding RequestedVersion}" Width="90" />
                                <DataGridTextColumn Header="Resolved" Binding="{Binding ResolvedVersion}" Width="90" />
                                <DataGridTextColumn Header="Deps" Binding="{Binding DependencyCount}" Width="58" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82" />
                                <DataGridTemplateColumn Header="Actions" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove" Click="RemoveAddedButton_Click" Tag="{Binding}" Padding="5,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE2EA" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RootsSummaryText" Text="Roots: 0" VerticalAlignment="Center" Margin="0,0,36,0" />
                <TextBlock Grid.Column="1" x:Name="DependenciesSummaryText" Text="Dependencies: 0" VerticalAlignment="Center" Margin="0,0,36,0" />
                <TextBlock Grid.Column="2" x:Name="TotalSummaryText" Text="Total Packages: 0" VerticalAlignment="Center" Margin="0,0,36,0" />
                <TextBlock Grid.Column="3" x:Name="SizeSummaryText" Text="Estimated Size: -" VerticalAlignment="Center" Margin="0,0,36,0" />
                <TextBlock Grid.Column="4" x:Name="StatusText" Text="Status: Ready" Foreground="#2F3640" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="5" x:Name="LogTextBox" Text="Log: Ready." Foreground="#4F5865" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
