<Window x:Class="OfflinePackageDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Offline Package Downloader" Height="760" Width="1160" MinHeight="700" MinWidth="1040">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE2EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0B63CE" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0B63CE" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7DCE5" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6773" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ProviderTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProviderTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Foreground" Value="#202833" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,8,0">
                            <Border x:Name="Underline"
                                    Height="4"
                                    Background="Transparent"
                                    CornerRadius="2"
                                    VerticalAlignment="Bottom" />
                            <ContentPresenter ContentSource="Header"
                                              Margin="10,8"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Background" Value="#1570D6" />
                                <Setter Property="Foreground" Value="#1570D6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchResultItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionBorder"
                                Padding="0"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#2B7DE9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F6F7F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDE2EA" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,8" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                    <Button x:Name="ResolveButton"
                            Content="Preview"
                            Click="ResolveButton_Click"
                            Style="{StaticResource SoftButton}"
                            MinWidth="86"
                            Margin="10,0,8,0"
                            Visibility="Collapsed" />
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Click="CancelButton_Click"
                            Style="{StaticResource SoftButton}"
                            MinWidth="82"
                            Visibility="Collapsed"
                            IsEnabled="False" />
                </StackPanel>
                <TabControl x:Name="ProviderList"
                            SelectionChanged="ProviderList_SelectionChanged"
                            Style="{StaticResource ProviderTabs}"
                            ItemContainerStyle="{StaticResource ProviderTabItem}"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="0"
                            ClipToBounds="True"
                            HorizontalAlignment="Left"
                            MinHeight="44">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="6" Background="#0B77D5" Margin="0,0,7,0">
                                    <TextBlock Text="{Binding DisplayName[0]}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
            </DockPanel>
        </Border>

        <Button Grid.Row="0"
                x:Name="SettingsButton"
                Content="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource SoftButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="118"
                Height="36"
                Margin="545,14,0,0"
                Panel.ZIndex="100" />

        <Grid Grid.Row="1" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.38*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="154" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchTextBox"
                                 Height="38"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"
                                 KeyDown="SearchTextBox_KeyDown" />
                        <Button Grid.Column="2" Content="Filters" Click="SearchButton_Click" Style="{StaticResource SoftButton}" Padding="6" />
                        <TextBlock Grid.Column="4" Text="Sort by:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#3F4650" />
                        <ComboBox Grid.Column="5" x:Name="SortComboBox" Height="38" SelectedIndex="0">
                            <ComboBoxItem Content="Relevance" />
                            <ComboBoxItem Content="Downloads" />
                            <ComboBoxItem Content="Name" />
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="1" Margin="14,6,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultsCountText" Text="Search packages to begin" FontWeight="SemiBold" Foreground="#303846" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&lt;" Style="{StaticResource SoftButton}" Padding="8,4" MinWidth="30" />
                            <Button Content="1" Background="#E8F1FF" BorderBrush="#2B7DE9" Padding="9,4" MinWidth="30" Margin="6,0" />
                            <TextBlock Text="2     3     ...     103" Foreground="#4F5865" VerticalAlignment="Center" Margin="4,0,8,0" />
                            <Button Content="&gt;" Style="{StaticResource SoftButton}" Padding="8,4" MinWidth="30" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="SearchResultsList"
                             Grid.Row="2"
                             ItemsSource="{Binding SearchResults}"
                             SelectionChanged="SearchResultsList_SelectionChanged"
                             ItemContainerStyle="{StaticResource SearchResultItem}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="206"
                                        Height="178"
                                        Background="White"
                                        BorderBrush="#E0E5EE"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,10,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" Background="#4F2BC8" CornerRadius="5" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding IconText}" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding PackageId}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" MaxHeight="34" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="by " Foreground="#5F6773" FontSize="11" />
                                                    <TextBlock Text="{Binding Publisher}" Foreground="#2F3640" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Description}"
                                                   Foreground="#374151"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   LineHeight="17"
                                                   Margin="0,10,0,8" />
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DownloadsText}" Style="{StaticResource MetaText}" />
                                                <TextBlock Text="  " />
                                                <TextBlock Text="{Binding LatestVersionText}" Style="{StaticResource MetaText}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Add +"
                                                    Click="AddSearchResult_Click"
                                                    Tag="{Binding}"
                                                    BorderBrush="#7BB5FF"
                                                    Foreground="#0B63CE"
                                                    Background="White"
                                                    Padding="10,4"
                                                    MinWidth="62" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.1*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="0.9*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Selected Package" FontSize="16" FontWeight="SemiBold" />
                        <Grid Grid.Row="1" Margin="0,20,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="60" Height="60" Background="#4F2BC8" CornerRadius="5" VerticalAlignment="Top">
                                <TextBlock x:Name="SelectedIconText" Text="N" Foreground="White" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SelectedNameText" Text="Select a package" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="  by " Foreground="#5F6773" VerticalAlignment="Bottom" />
                                    <TextBlock x:Name="SelectedPublisherText" Text="" Foreground="#2F3640" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <UniformGrid Columns="3" Margin="0,18,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Latest Version" Style="{StaticResource MetaText}" />
                                        <TextBlock x:Name="SelectedVersionText" Text="-" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Downloads" Style="{StaticResource MetaText}" />
                                        <TextBlock x:Name="SelectedDownloadsText" Text="-" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="License" Style="{StaticResource MetaText}" />
                                        <TextBlock x:Name="SelectedLicenseText" Text="-" FontWeight="SemiBold" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock x:Name="SelectedDescriptionText" TextWrapping="Wrap" Foreground="#374151" />
                                <TextBlock Text="Dependency preview" FontWeight="SemiBold" Margin="0,14,0,6" />
                                <TextBlock x:Name="SelectedDependenciesText" Text="Resolve Preview updates exact dependencies." Foreground="#4F5865" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2" x:Name="SelectedProviderText" Text="Provider" Foreground="#5F6773" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear All" Click="ClearAddedButton_Click" Foreground="#DC2626" Style="{StaticResource SoftButton}" MinWidth="82" />
                            <TextBlock Text="Added Packages" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid Grid.Row="1"
                                  x:Name="AddedPackagesGrid"
                                  ItemsSource="{Binding AddedPackages}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Package" Binding="{Binding PackageId}" Width="2*" />
                                <DataGridTextColumn Header="Requested" Binding="{Binding RequestedVersion}" Width="90" />
                                <DataGridTextColumn Header="Resolved" Binding="{Binding ResolvedVersion}" Width="90" />
                                <DataGridTextColumn Header="Deps" Binding="{Binding DependencyCount}" Width="58" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82" />
                                <DataGridTemplateColumn Header="Actions" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Del" Click="RemoveAddedButton_Click" Tag="{Binding}" Padding="5,2" Foreground="#DC2626" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE2EA" BorderThickness="1" CornerRadius="8" Margin="16,0,16,16">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RootsSummaryText" Text="Roots: 0" VerticalAlignment="Center" Margin="0,0,36,0" />
                <TextBlock Grid.Column="1" x:Name="DependenciesSummaryText" Text="Dependencies: 0" VerticalAlignment="Center" Margin="0,0,36,0" />
                <TextBlock Grid.Column="2" x:Name="TotalSummaryText" Text="Total Packages: 0" VerticalAlignment="Center" Margin="0,0,36,0" />
                <TextBlock Grid.Column="3" x:Name="SizeSummaryText" Text="Estimated Size: -" VerticalAlignment="Center" Margin="0,0,36,0" />
                <TextBlock Grid.Column="4" x:Name="StatusText" Text="Status: Ready" Foreground="#2F3640" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="5" x:Name="LogTextBox" Text="Log: Ready." Foreground="#4F5865" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,18,0" />
                <Button Grid.Column="6"
                        x:Name="DownloadButton"
                        Content="Download"
                        Click="DownloadButton_Click"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="150"
                        Height="38" />
            </Grid>
        </Border>
    </Grid>
</Window>
