                                    <TextBlock Text="Relevance" FontSize="17" Foreground="#293241" VerticalAlignment="Center" />
                                    <TextBlock Text="⌄" FontSize="22" Foreground="#293241" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock Text="1,234 results for “configuration json”"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#253041"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Showing 1 – 12 of 1,234"
                                           FontSize="16"
                                           Foreground="#465366"
                                           Margin="0,0,26,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="‹" FontSize="34" Foreground="#7B8494" Margin="0,0,18,0" VerticalAlignment="Center" />
                                <Border Width="36" Height="36" BorderBrush="#147BD1" BorderThickness="1.5" CornerRadius="5" Margin="0,0,16,0">
                                    <TextBlock Text="1" Foreground="#147BD1" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="2" FontSize="16" Foreground="#465366" Margin="0,0,22,0" VerticalAlignment="Center" />
                                <TextBlock Text="3" FontSize="16" Foreground="#465366" Margin="0,0,30,0" VerticalAlignment="Center" />
                                <TextBlock Text="..." FontSize="16" Foreground="#465366" Margin="0,0,30,0" VerticalAlignment="Center" />
                                <TextBlock Text="103" FontSize="16" Foreground="#465366" Margin="0,0,20,0" VerticalAlignment="Center" />
                                <TextBlock Text="›" FontSize="34" Foreground="#293241" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource PackageCard}" BorderBrush="#2E8BEF" BorderThickness="2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="80" />
                                            <RowDefinition Height="94" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Background="#5B2DD1">
                                                <TextBlock Text=".NET" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="14,0,0,0">
                                                <TextBlock Text="Microsoft.Extensions-" FontSize="15" FontWeight="SemiBold" Foreground="#111827" />
                                                <TextBlock Text="Configuration.Json" FontSize="15" FontWeight="SemiBold" Foreground="#111827" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="by Microsoft" FontSize="14" Foreground="#4B5563" />
                                                    <TextBlock Text=" ●" FontSize="14" Foreground="#147BD1" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1"
                                                   Text="JSON configuration provider implementation for Microsoft Extensions Configuration."
                                                   TextWrapping="Wrap"
                                                   FontSize="15"
                                                   Foreground="#374151"
                                                   LineHeight="22" />
                                        <Grid Grid.Row="2">
                                            <TextBlock Text="⇩ 241.3M     ◇ v8.0.0" FontSize="14" Foreground="#4B5563" VerticalAlignment="Center" />
                                            <Button Width="78" Height="36" HorizontalAlignment="Right" Style="{StaticResource PlainButton}" Foreground="#147BD1" Content="Add  +" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource PackageCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="80" />
                                            <RowDefinition Height="94" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Background="#0A858C">
                                                <TextBlock Text="J" Foreground="White" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="14,0,0,0">
                                                <TextBlock Text="JsonConfiguration" FontSize="15" FontWeight="SemiBold" Foreground="#111827" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="by Marko Lahma" FontSize="14" Foreground="#4B5563" />
                                                    <TextBlock Text=" ●" FontSize="14" Foreground="#147BD1" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Simple JSON based configuration provider for .NET applications." TextWrapping="Wrap" FontSize="15" Foreground="#374151" LineHeight="22" />
                                        <Grid Grid.Row="2">
                                            <TextBlock Text="⇩ 5.1M     ◇ v3.2.1" FontSize="14" Foreground="#4B5563" VerticalAlignment="Center" />
                                            <Button Width="78" Height="36" HorizontalAlignment="Right" Style="{StaticResource PlainButton}" Foreground="#147BD1" Content="Add  +" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource PackageCard}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="80" />
                                            <RowDefinition Height="94" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⬡" FontSize="55" Foreground="#0B5EA8" Width="62" HorizontalAlignment="Center" />
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="NJxonSchema" FontSize="15" FontWeight="SemiBold" Foreground="#111827" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="by Rico Suter" FontSize="14" Foreground="#4B5563" />
                                                    <TextBlock Text=" ●" FontSize="14" Foreground="#147BD1" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Generates strongly typed clients and JSON schemas for .NET from OpenAPI (Swagger) specifications." TextWrapping="Wrap" FontSize="15" Foreground="#374151" LineHeight="22" />
                                        <Grid Grid.Row="2">
                                            <TextBlock Text="⇩ 24.7M     ◇ v11.0.0" FontSize="14" Foreground="#4B5563" VerticalAlignment="Center" />
                                            <Button Width="78" Height="36" HorizontalAlignment="Right" Style="{StaticResource PlainButton}" Foreground="#147BD1" Content="Add  +" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource PackageCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="80" />
                                            <RowDefinition Height="94" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Background="#42A53B">
                                                <TextBlock Text="⬢" Foreground="White" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="14,0,0,0">
                                                <TextBlock Text="Microsoft.Extensions.Configuration" FontSize="14" FontWeight="SemiBold" Foreground="#111827" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="by Microsoft" FontSize="14" Foreground="#4B5563" />
                                                    <TextBlock Text=" ●" FontSize="14" Foreground="#147BD1" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Abstractions and implementation of key-value pair based configuration." TextWrapping="Wrap" FontSize="15" Foreground="#374151" LineHeight="22" />
                                        <Grid Grid.Row="2">
                                            <TextBlock Text="⇩ 1.18B     ◇ v8.0.0" FontSize="14" Foreground="#4B5563" VerticalAlignment="Center" />
                                            <Button Width="78" Height="36" HorizontalAlignment="Right" Style="{StaticResource PlainButton}" Foreground="#147BD1" Content="Add  +" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource PackageCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="80" />
                                            <RowDefinition Height="94" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Background="#1468A8">
                                                <TextBlock Text="{}{ }" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="14,0,0,0">
                                                <TextBlock Text="Newtonsoft.Json" FontSize="15" FontWeight="SemiBold" Foreground="#111827" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="by James Newton-King" FontSize="14" Foreground="#4B5563" />
                                                    <TextBlock Text=" ●" FontSize="14" Foreground="#147BD1" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Json.NET is a popular high-performance JSON framework for .NET." TextWrapping="Wrap" FontSize="15" Foreground="#374151" LineHeight="22" />
                                        <Grid Grid.Row="2">
                                            <TextBlock Text="⇩ 2.22B     ◇ v13.0.3" FontSize="14" Foreground="#4B5563" VerticalAlignment="Center" />
                                            <Button Width="78" Height="36" HorizontalAlignment="Right" Style="{StaticResource PlainButton}" Foreground="#147BD1" Content="Add  +" />
                                        </Grid>
