<Window x:Class="OfflinePackageDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Offline Package Downloader"
        Width="1440"
        Height="944"
        MinWidth="1280"
        MinHeight="800"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI">
    <Grid Background="#F6F8FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="118" />
            <RowDefinition Height="*" />
            <RowDefinition Height="104" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DCE3EC" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TabControl x:Name="ProviderList"
                            SelectionChanged="ProviderList_SelectionChanged"
                            Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NuGetProviderButton" Click="ProviderButton_Click" Tag="0" Style="{StaticResource ProviderButton}" Margin="0,0,24,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="8" Background="#0E83D7" Margin="0,0,9,0">
                                    <TextBlock Text="●" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="NuGet" x:Name="NuGetProviderText" FontSize="18" FontWeight="SemiBold" Foreground="#1685E5" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="NuGetProviderUnderline" Height="5" Background="#1685E5" CornerRadius="2.5" Margin="0,18,0,0" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="PythonProviderButton" Click="ProviderButton_Click" Tag="1" Style="{StaticResource ProviderButton}" Margin="0,0,24,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="8" Background="#F0C13A" Margin="0,0,9,0">
                                    <TextBlock Text="🐍" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Python" x:Name="PythonProviderText" FontSize="18" FontWeight="SemiBold" Foreground="#202833" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="PythonProviderUnderline" Height="5" Background="Transparent" CornerRadius="2.5" Margin="0,18,0,0" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="VSCodeProviderButton" Click="ProviderButton_Click" Tag="2" Style="{StaticResource ProviderButton}" Margin="0,0,24,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="8" Background="#147FD1" Margin="0,0,9,0">
                                    <TextBlock Text="◆" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="VS Code Extension" x:Name="VSCodeProviderText" FontSize="18" FontWeight="SemiBold" Foreground="#202833" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="VSCodeProviderUnderline" Height="5" Background="Transparent" CornerRadius="2.5" Margin="0,18,0,0" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="UbuntuProviderButton" Click="ProviderButton_Click" Tag="3" Style="{StaticResource ProviderButton}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="8" Background="#E95420" Margin="0,0,9,0">
                                    <TextBlock Text="◉" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Ubuntu" x:Name="UbuntuProviderText" FontSize="18" FontWeight="SemiBold" Foreground="#202833" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="UbuntuProviderUnderline" Height="5" Background="Transparent" CornerRadius="2.5" Margin="0,18,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="SettingsButton"
                            Content="Settings"
                            Click="SettingsButton_Click"
                            Style="{StaticResource SoftButton}"
                            Width="118"
                            Height="50"
                            Margin="0,0,0,0" />
                    <Button x:Name="ResolveButton"
                            Content="Preview"
                            Click="ResolveButton_Click"
                            Visibility="Collapsed" />
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Click="CancelButton_Click"
                            IsEnabled="False"
                            Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,18,26,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.36*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="92" />
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="22,18,22,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="126" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="SearchTextBox"
                                     Height="50"
                                     FontSize="17"
                                     Padding="42,0,40,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchTextBox_KeyDown" />
                            <TextBlock Text="⌕" FontSize="24" Foreground="#687386" VerticalAlignment="Center" Margin="14,0,0,0" />
                            <TextBlock Text="×" FontSize="22" Foreground="#687386" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                        </Grid>
                        <Button Grid.Column="2"
                                Content="⌯  Filters"
                                Click="SearchButton_Click"
                                Style="{StaticResource SoftButton}"
                                Height="50" />
                        <TextBlock Grid.Column="4"
                                   Text="Sort by"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   Foreground="#596578"
                                   Margin="0,0,12,0" />
                        <ComboBox Grid.Column="5" x:Name="SortComboBox" Height="50" FontSize="15" SelectedIndex="0">
                            <ComboBoxItem Content="Relevance" />
                            <ComboBoxItem Content="Downloads" />
                            <ComboBoxItem Content="Name" />
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="1" Margin="22,0,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultsCountText"
                                   Text="1,234 results for &quot;configuration json&quot;"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#283142"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,18,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Showing 1 - 12 of 1,234" FontSize="15" Foreground="#596578" VerticalAlignment="Center" Margin="0,0,22,0" />
                            <Button Content="‹" Style="{StaticResource SoftButton}" Width="38" Height="38" Padding="0" />
                            <Button Content="1" Width="38" Height="38" Padding="0" Margin="8,0" Background="#E7F1FF" BorderBrush="#2B83F6" Foreground="#0A62C7" />
                            <TextBlock Text="2     3     ...     103" FontSize="15" Foreground="#596578" VerticalAlignment="Center" Margin="2,0,10,0" />
                            <Button Content="›" Style="{StaticResource SoftButton}" Width="38" Height="38" Padding="0" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="SearchResultsList"
                             Grid.Row="2"
                             ItemsSource="{Binding SearchResults}"
                             SelectionChanged="SearchResultsList_SelectionChanged"
                             ItemContainerStyle="{StaticResource SearchResultItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="22,0,8,18"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="288"
                                        Height="230"
                                        Background="White"
                                        BorderBrush="#DDE4ED"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="50" Height="50" CornerRadius="6" Background="{Binding IconBackground}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding IconText}" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding PackageId}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="42" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="by " FontSize="13" Foreground="#596578" />
                                                    <TextBlock Text="{Binding Publisher}" FontSize="13" Foreground="#445065" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Description}"
                                                   FontSize="14"
                                                   Foreground="#374151"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20"
                                                   Margin="0,16,0,10" />

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⇩" Foreground="#596578" FontSize="16" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding DownloadsText}" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="   ◇   " Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding LatestVersion}" Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Add  +"
                                                    Click="AddSearchResult_Click"
                                                    Tag="{Binding}"
                                                    Width="84"
                                                    Height="38"
                                                    Background="White"
                                                    Foreground="#0B70D1"
                                                    BorderBrush="#7BB5FF"
                                                    FontSize="15" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="520" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="⌃" Foreground="#687386" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Text="Selected Package" FontSize="20" FontWeight="SemiBold" />
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,28,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="94" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="76" Height="76" CornerRadius="6" Background="#542CCB" VerticalAlignment="Top">
                                <TextBlock x:Name="SelectedIconText" Text=".NET" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SelectedNameText" Text="Microsoft.Extensions.Configuration.Json" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="  by " FontSize="14" Foreground="#596578" VerticalAlignment="Bottom" />
                                    <TextBlock x:Name="SelectedPublisherText" Text="Microsoft" FontSize="14" Foreground="#445065" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <UniformGrid Columns="3" Margin="0,30,0,26">
                                    <StackPanel>
                                        <TextBlock Text="Latest Version" Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="SelectedVersionText" Text="8.0.0" FontWeight="SemiBold" FontSize="15" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Downloads" Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="SelectedDownloadsText" Text="241.3M" FontWeight="SemiBold" FontSize="15" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="License" Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="SelectedLicenseText" Text="MIT" FontWeight="SemiBold" FontSize="15" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock x:Name="SelectedDescriptionText"
                                           Text="JSON configuration provider implementation for Microsoft Extensions Configuration."
                                           TextWrapping="Wrap"
                                           FontSize="15"
                                           Foreground="#374151"
                                           LineHeight="22" />

                                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                                    <TextBlock Text="◎  Project Link" FontSize="15" Foreground="#374151" Margin="0,0,18,0" />
                                    <TextBlock x:Name="SelectedProjectLinkText" Text="https://github.com/dotnet/runtime" FontSize="15" Foreground="#0B70D1" />
                                </StackPanel>

                                <TextBlock Text="Dependencies (preview)" FontWeight="SemiBold" FontSize="15" Margin="0,24,0,10" />
                                <TextBlock x:Name="SelectedDependenciesText"
                                           Text="NuGet dependency closure will be resolved for the saved target framework."
                                           Foreground="#687386"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <WrapPanel>
                                    <Border Background="#F7F8FA" BorderBrush="#DFE5EE" BorderThickness="1" CornerRadius="4" Padding="12,7" Margin="0,0,8,8">
                                        <TextBlock Text="Microsoft.Extensions.Configuration.Abstractions (&gt;= 8.0.0)" FontSize="14" />
                                    </Border>
                                    <Border Background="#F7F8FA" BorderBrush="#DFE5EE" BorderThickness="1" CornerRadius="4" Padding="12,7" Margin="0,0,8,8">
                                        <TextBlock Text="Microsoft.Extensions.Primitives (&gt;= 8.0.0)" FontSize="14" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="2" x:Name="SelectedProviderText" Text="NuGet" Style="{StaticResource MutedText}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="🗑  Clear All"
                                    Click="ClearAddedButton_Click"
                                    Foreground="#E15252"
                                    Style="{StaticResource SoftButton}"
                                    Width="116"
                                    Height="42" />
                            <TextBlock Text="Added Packages" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>

                        <DataGrid Grid.Row="1"
                                  x:Name="AddedPackagesGrid"
                                  ItemsSource="{Binding AddedPackages}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="White"
                                  BorderBrush="#E2E7EF"
                                  BorderThickness="1"
                                  RowHeight="58"
                                  FontSize="14"
                                  Margin="0,18,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Package ID" Binding="{Binding PackageId}" Width="2.3*" />
                                <DataGridTextColumn Header="Requested Version" Binding="{Binding RequestedVersion}" Width="115" />
                                <DataGridTextColumn Header="Resolved Version" Binding="{Binding ResolvedVersion}" Width="115" />
                                <DataGridTextColumn Header="Deps" Binding="{Binding DependencyCount}" Width="70" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                                <DataGridTemplateColumn Header="Actions" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑" Click="RemoveAddedButton_Click" Tag="{Binding}" Foreground="#E15252" Background="White" BorderBrush="Transparent" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="26,0,26,24">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="210" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✣" FontSize="32" Foreground="#5B6678" Margin="0,0,14,0" />
                    <StackPanel>
                        <TextBlock Text="Roots" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="RootsSummaryText" Text="3" FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#E1E6EE" Height="42" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                    <TextBlock Text="⬡" FontSize="32" Foreground="#5B6678" Margin="0,0,14,0" />
                    <StackPanel>
                        <TextBlock Text="Dependencies" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="DependenciesSummaryText" Text="4" FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="3" Background="#E1E6EE" Height="42" VerticalAlignment="Center" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                    <TextBlock Text="▧" FontSize="32" Foreground="#5B6678" Margin="0,0,14,0" />
                    <StackPanel>
                        <TextBlock Text="Total Packages" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="TotalSummaryText" Text="7" FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="5" Background="#E1E6EE" Height="42" VerticalAlignment="Center" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                    <TextBlock Text="▰" FontSize="32" Foreground="#5B6678" Margin="0,0,14,0" />
                    <StackPanel>
                        <TextBlock Text="Estimated Size" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="SizeSummaryText" Text="12.45 MB" FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="7" Background="#E1E6EE" Height="42" VerticalAlignment="Center" />
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                    <TextBlock Text="✓" FontSize="32" Foreground="#5B6678" Margin="0,0,14,0" />
                    <StackPanel>
                        <TextBlock Text="Status" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="#138A36" FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="9" x:Name="LogTextBox" Text="Log: Ready." Foreground="#687386" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="24,0" />
                <Button Grid.Column="10"
                        x:Name="DownloadButton"
                        Content="⇩  Download"
                        Click="DownloadButton_Click"
                        Style="{StaticResource PrimaryButton}"
                        Height="58"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
