                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="80" />
                                            <RowDefinition Height="94" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Background="#2F73B7">
                                                <TextBlock Text="☁" Foreground="White" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="14,0,0,0">
                                                <TextBlock Text="Serilog.Settings.Configuration" FontSize="14" FontWeight="SemiBold" Foreground="#111827" />
                                                <TextBlock Text="by Serilog Contributors" FontSize="14" Foreground="#4B5563" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Configuration support for Serilog using Microsoft.Extensions.Configuration." TextWrapping="Wrap" FontSize="15" Foreground="#374151" LineHeight="22" />
                                        <Grid Grid.Row="2">
                                            <TextBlock Text="⇩ 34.6M" FontSize="14" Foreground="#4B5563" VerticalAlignment="Center" />
                                            <Button Width="78" Height="36" HorizontalAlignment="Right" Style="{StaticResource PlainButton}" Foreground="#147BD1" Content="Add  +" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource PackageCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="80" />
                                            <RowDefinition Height="94" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Background="#D53B2F">
                                                <TextBlock Text="○" Foreground="White" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
