                                        <TextBlock Grid.Row="1" Text="Integration between Autofac and configuration providers." TextWrapping="Wrap" FontSize="15" Foreground="#374151" LineHeight="22" />
                                        <Grid Grid.Row="2">
                                            <TextBlock Text="⇩ 12.7M     ◇ v7.0.0" FontSize="14" Foreground="#4B5563" VerticalAlignment="Center" />
