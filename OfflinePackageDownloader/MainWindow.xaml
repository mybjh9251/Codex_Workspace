                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Background="#0E8388">
                                                <TextBlock Text="≡" Foreground="White" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
