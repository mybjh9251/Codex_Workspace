<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#687386" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="MockupHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#111827" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MockupMutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#667085" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="MockupBodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#374151" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="23" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ToolbarLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="#667085" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SearchSummaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#253041" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageSummaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="#465366" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ActivePageText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#147BD1" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="QueueHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#374151" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
