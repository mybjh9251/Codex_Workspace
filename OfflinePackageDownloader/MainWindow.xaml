<Window x:Class="OfflinePackageDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Offline Package Downloader"
        Width="1820"
        Height="1180"
        MinWidth="1280"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        FontFamily="Segoe UI">
    <Grid Background="#F4F7FB">
        <Viewbox Stretch="Uniform"
                 StretchDirection="Both"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 ClipToBounds="True">
            <Grid Width="1800" Height="1120" Background="#F4F7FB">
                <Grid.RowDefinitions>
                    <RowDefinition Height="118" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="96" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#DDE3EA"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="142" />
                        </Grid.ColumnDefinitions>

                        <ItemsControl ItemsSource="{Binding ProviderTabs}"
                                      ItemTemplate="{StaticResource ProviderTabTemplate}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Button Grid.Column="1"
                                Width="128"
                                Height="48"
                                Style="{StaticResource MockupPlainButton}"
                                Click="SettingsButton_Click"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="21" Margin="0,0,8,0" />
                                <TextBlock Text="Settings" FontSize="17" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="28,22,28,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="980" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62" />
                            <RowDefinition Height="52" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="500" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>

                            <Border Height="48"
                                    Background="White"
                                    BorderBrush="#D8E0EA"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    VerticalAlignment="Top">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⌕"
                                               FontSize="29"
                                               Foreground="#303A48"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="19"
                                             Foreground="#3A414C"
                                             VerticalAlignment="Center"
                                             KeyDown="SearchTextBox_KeyDown" />
                                    <Button Grid.Column="2"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            FontSize="22"
                                            Foreground="#697586"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Click="ClearSearchButton_Click"
                                            Content="×" />
                                </Grid>
                            </Border>

                            <Button x:Name="FilterButton"
                                    Grid.Column="2"
                                    Height="48"
                                    Style="{StaticResource MockupPlainButton}"
                                    Click="FilterButton_Click"
                                    VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▽" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock Text="Filters" />
                                </StackPanel>
                            </Button>

                            <Popup Grid.Column="2"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=FilterButton}"
                                   IsOpen="{Binding IsFilterPopupOpen}"
                                   StaysOpen="False">
                                <Border Margin="0,8,0,0"
                                        Padding="14"
                                        Background="White"
                                        BorderBrush="#D8E0EA"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <CheckBox Content="Microsoft publisher only"
                                              IsChecked="{Binding MicrosoftPublisherOnly}" />
                                </Border>
                            </Popup>

                            <TextBlock Grid.Column="4"
                                       Text="Sort by"
                                       FontSize="15"
                                       Foreground="#667085"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="5"
                                      Height="48"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SortLabel}"
                                      SelectionChanged="SortComboBox_SelectionChanged"
                                      FontSize="17"
                                      Foreground="#293241"
                                      VerticalAlignment="Top" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock Text="{Binding ResultCountText}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#253041"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding PageSummaryText}"
                                           FontSize="16"
                                           Foreground="#465366"
                                           Margin="0,0,26,0"
                                           VerticalAlignment="Center" />
                                <Button Width="32"
                                        Height="36"
                                        Margin="0,0,18,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="‹"
                                        FontSize="27"
                                        Foreground="#7B8494"
                                        IsEnabled="{Binding HasPreviousPage}"
                                        Click="PreviousPageButton_Click" />
                                <Border Width="36" Height="36" BorderBrush="#147BD1" BorderThickness="1.5" CornerRadius="5" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding CurrentPageText}" Foreground="#147BD1" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding NextPageText}" FontSize="16" Foreground="#465366" Margin="0,0,22,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FollowingPageText}" FontSize="16" Foreground="#465366" Margin="0,0,30,0" VerticalAlignment="Center" />
                                <TextBlock Text="..." FontSize="16" Foreground="#465366" Margin="0,0,30,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalPagesText}" FontSize="16" Foreground="#465366" Margin="0,0,20,0" VerticalAlignment="Center" />
                                <Button Width="32"
                                        Height="36"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="›"
                                        FontSize="27"
                                        Foreground="#293241"
                                        IsEnabled="{Binding HasNextPage}"
                                        Click="NextPageButton_Click" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding SearchResults}"
                                          ItemTemplate="{StaticResource PackageCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource MockupPanelBorder}"
                                Padding="22">
                            <Grid DataContext="{Binding SelectedPackage}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Selected Package" Style="{StaticResource MockupHeaderText}" />
                                <Button Width="34"
                                        Height="34"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        FontSize="24"
                                        Foreground="#64748B"
                                        Content="{Binding DataContext.SelectedPackageToggleGlyph, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        Click="SelectedPackageToggleButton_Click" />

                                <Grid Grid.Row="1" Margin="0,8,0,0"
                                      Visibility="{Binding DataContext.IsSelectedPackageExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="80"
                                            Height="80"
                                            Background="{Binding IconBackground}"
                                            CornerRadius="4"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding IconText}"
                                                   Foreground="White"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,6,0,0">
                                        <TextBlock Text="{Binding PackageId}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PublisherText}" FontSize="16" Foreground="#4B5563" />
                                            <TextBlock Text=" ●" FontSize="17" Foreground="#147BD1" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2"
                                      Margin="0,12,0,0"
                                      Visibility="{Binding DataContext.IsSelectedPackageExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◇" FontSize="28" Foreground="#3B4351" Margin="0,0,12,0" />
                                        <StackPanel>
                                            <TextBlock Text="Latest Version" Style="{StaticResource MockupMutedText}" />
                                            <TextBlock Text="{Binding LatestVersion}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#E5EAF1" Margin="0,6" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="22,0,0,0">
                                        <TextBlock Text="⇩" FontSize="31" Foreground="#3B4351" Margin="0,0,12,0" />
                                        <StackPanel>
                                            <TextBlock Text="Downloads" Style="{StaticResource MockupMutedText}" />
                                            <TextBlock Text="{Binding DownloadsText}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="3" Background="#E5EAF1" Margin="0,6" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="22,0,0,0">
                                        <TextBlock Text="⚖" FontSize="27" Foreground="#3B4351" Margin="0,0,12,0" />
                                        <StackPanel>
                                            <TextBlock Text="License" Style="{StaticResource MockupMutedText}" />
                                            <TextBlock Text="{Binding License}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="3"
                                           Text="{Binding Description}"
                                           Style="{StaticResource MockupBodyText}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,14,0,0"
                                           Visibility="{Binding DataContext.IsSelectedPackageExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,14,0,0"
                                            Visibility="{Binding DataContext.IsSelectedPackageExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="◎" FontSize="22" Foreground="#3B4351" Margin="0,0,12,0" />
                                    <TextBlock Text="Project Link" FontSize="15" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,22,0" />
                                    <TextBlock Text="{Binding ProjectUrl}" FontSize="15" Foreground="#147BD1" />
                                </StackPanel>

                                <StackPanel Grid.Row="5" Margin="0,14,0,0"
                                            Visibility="{Binding DataContext.IsSelectedPackageExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Dependencies (preview)" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding DependencyChips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource MockupDependencyChip}">
                                                    <TextBlock Text="{Binding}" FontSize="15" Foreground="#374151" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource MockupPanelBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="20,0">
                                    <TextBlock Text="{Binding AddedPackagesTitle}" Style="{StaticResource MockupHeaderText}" VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Click="ClearAddedPackagesButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="♙" Foreground="#EF4444" FontSize="21" Margin="0,0,8,0" />
                                        <TextBlock Text="Clear All" Foreground="#EF4444" FontSize="15" VerticalAlignment="Center" />
                                    </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Grid.Row="1" Background="#F7F9FC">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Package ID" Margin="20,0,0,0" FontSize="14" Foreground="#374151" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Requested Version" FontSize="13" Foreground="#374151" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Resolved Version" FontSize="13" Foreground="#374151" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="Deps" FontSize="14" Foreground="#374151" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="Status" FontSize="14" Foreground="#374151" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl Grid.Row="2"
                                              ItemsSource="{Binding AddedPackages}"
                                              ItemTemplate="{StaticResource AddedPackageRowTemplate}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="2"
                        Style="{StaticResource MockupPanelBorder}"
                        Margin="28,10,28,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="290" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="290" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ContentControl Content="{Binding SummaryMetrics[0]}"
                                        ContentTemplate="{StaticResource SummaryMetricTemplate}" />
                        <Border Grid.Column="1" Background="#DDE5EF" Margin="0,16" />
                        <ContentControl Grid.Column="2"
                                        Content="{Binding SummaryMetrics[1]}"
                                        ContentTemplate="{StaticResource SummaryMetricTemplate}" />
                        <Border Grid.Column="3" Background="#DDE5EF" Margin="0,16" />
                        <ContentControl Grid.Column="4"
                                        Content="{Binding SummaryMetrics[2]}"
                                        ContentTemplate="{StaticResource SummaryMetricTemplate}" />
                        <Border Grid.Column="5" Background="#DDE5EF" Margin="0,16" />
                        <ContentControl Grid.Column="6"
                                        Content="{Binding SummaryMetrics[3]}"
                                        ContentTemplate="{StaticResource SummaryMetricTemplate}" />
                        <Border Grid.Column="7" Background="#DDE5EF" Margin="0,16" />
                        <ContentControl Grid.Column="8"
                                        Content="{Binding SummaryMetrics[4]}"
                                        ContentTemplate="{StaticResource SummaryMetricTemplate}" />

                        <StackPanel Grid.Column="9"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,24,0">
                            <Button Width="132"
                                    Height="52"
                                    Margin="0,0,12,0"
                                    Style="{StaticResource MockupPlainButton}"
                                    Click="PreviewButton_Click"
                                    Content="Preview" />
                            <Button Width="230"
                                    Height="52"
                                    Style="{StaticResource MockupPrimaryButton}"
                                    Click="DownloadButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⇩" FontSize="27" Margin="0,0,10,0" />
                                <TextBlock Text="Download" FontSize="19" VerticalAlignment="Center" />
                            </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
