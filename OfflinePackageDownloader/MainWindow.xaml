<Window x:Class="OfflinePackageDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Offline Package Downloader"
        Width="1820"
        Height="1180"
        MinWidth="1280"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#147BD1" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE5EF" />

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E0EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#293241" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Background" Value="#0875D1" />
            <Setter Property="BorderBrush" Value="#0875D1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="PackageCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DFE6EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,14,14" />
        </Style>
    </Window.Resources>

    <Grid Background="#F4F7FB">
        <Viewbox Stretch="Uniform"
                 StretchDirection="Both"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 ClipToBounds="True">
            <Grid Width="1800" Height="1120" Background="#F4F7FB">
                <Grid.RowDefinitions>
                    <RowDefinition Height="118" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="96" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#DDE3EA"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="142" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Grid Width="132" Height="82" Margin="0,0,26,0">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="7" Background="#167BD8">
                                        <TextBlock Text="●" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="NuGet" Margin="10,0,0,0" FontSize="19" FontWeight="SemiBold" Foreground="#147BD1" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Height="6" Background="#147BD1" CornerRadius="3" VerticalAlignment="Bottom" />
                            </Grid>

                            <Grid Width="132" Height="82" Margin="0,0,26,0">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="7" Background="#2387C8">
                                        <TextBlock Text="P" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Python" Margin="10,0,0,0" FontSize="19" Foreground="#1F2937" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Grid Width="218" Height="82" Margin="0,0,26,0">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="◆" FontSize="34" Foreground="#1685E5" VerticalAlignment="Center" />
                                    <TextBlock Text="VS Code Extension" Margin="10,0,0,0" FontSize="19" Foreground="#1F2937" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Grid Width="132" Height="82">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#E95420">
                                        <TextBlock Text="U" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Ubuntu" Margin="10,0,0,0" FontSize="19" Foreground="#1F2937" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="128"
                                Height="48"
                                Style="{StaticResource PlainButton}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="21" Margin="0,0,8,0" />
                                <TextBlock Text="Settings" FontSize="17" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="28,22,28,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="980" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62" />
                            <RowDefinition Height="52" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="500" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>

                            <Border Height="48"
                                    Background="White"
                                    BorderBrush="#D8E0EA"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    VerticalAlignment="Top">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⌕" FontSize="29" Foreground="#303A48" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="configuration json" FontSize="19" Foreground="#3A414C" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="×" FontSize="25" Foreground="#697586" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <Button Grid.Column="2" Height="48" Style="{StaticResource PlainButton}" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▽" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock Text="Filters" />
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Column="4"
                                       Text="Sort by"
                                       FontSize="15"
                                       Foreground="#667085"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center" />
