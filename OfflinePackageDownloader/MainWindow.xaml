                                                <TextBlock Text="System.Text.Json" FontSize="15" FontWeight="SemiBold" Foreground="#111827" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="by Microsoft" FontSize="14" Foreground="#4B5563" />
                                                    <TextBlock Text=" ●" FontSize="14" Foreground="#147BD1" />
                                                </StackPanel>
                                            </StackPanel>
